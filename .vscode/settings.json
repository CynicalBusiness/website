{
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.quickSuggestions": {
        "strings": "on" // https://github.com/tailwindlabs/tailwindcss-intellisense?tab=readme-ov-file#recommended-vs-code-settings
    },
    // "tailwindCSS.experimental.configFile": {
    //     "packages/apps/web/src/styles/styles.css": "packages/apps/web/**"
    // },

    // Disable SCSS validation and let stylelint handle it
    "scss.validate": false,

    // "prettier.enable": false,

    "files.associations": {
        "*.css": "tailwindcss"
    },
    "files.readonlyInclude": {
        "**/routeTree.gen.ts": true
    },
    "files.watcherExclude": {
        "**/routeTree.gen.ts": true
    },
    "search.exclude": {
        "**/routeTree.gen.ts": true
    },

    "typescript.preferences.importModuleSpecifierEnding": "js"
}
