{
    "name": "web",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/apps/web",
    "projectType": "application",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/next:build",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "development",
            "options": {
                "outputPath": "packages/apps/web/dist/"
            },
            "configurations": {
                "development": {
                    "debug": true
                },
                "production": {}
            }
        },
        "serve": {
            "executor": "@nx/next:server",
            "defaultConfiguration": "development",
            "options": {
                "dev": true
            },
            "configurations": {
                "development": {
                    "dev": true,
                    "buildTarget": "web:build:development"
                },
                "production": {
                    "dev": false,
                    "buildTarget": "web:build:production"
                }
            }
        },
        "build-custom-server": {
            "executor": "@nx/js:tsc",
            "defaultConfiguration": "production",
            "options": {
                "outputPath": "packages/apps/web/dist/",
                "main": "packages/apps/web/server/main.ts",
                "tsConfig": "packages/apps/web/tsconfig.server.json",
                "clean": false,
                "assets": []
            },
            "configurations": {
                "development": {},
                "production": {}
            }
        },
        "serve-custom-server": {
            "executor": "@nx/js:node",
            "defaultConfiguration": "production",
            "options": {
                "buildTarget": "web:build-custom-server"
            },
            "configurations": {
                "development": {
                    "buildTarget": "web:build-custom-server:development"
                },
                "production": {
                    "buildTarget": "web:build-custom-server:production"
                }
            }
        }
    }
}
