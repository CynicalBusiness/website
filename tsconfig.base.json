{
    "compileOnSave": false,
    "compilerOptions": {
        "moduleResolution": "bundler",
        "module": "ESNext",
        "target": "ESNext",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "baseUrl": ".",
        "jsx": "react-jsx",

        "strict": true,
        "skipLibCheck": true
    }
}
